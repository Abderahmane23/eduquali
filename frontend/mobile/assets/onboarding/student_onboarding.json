{
  "id": "student_onboarding",
  "version": 2,
  "audience": "STUDENT",
  "locale": "fr",
  "currency": "GNF",
  "sections": [
    {
      "id": "about_you",
      "label": "Vous",
      "steps": [
        {
          "id": "identity",
          "type": "form",
          "title": "Comment vous appelez-vous ?",
          "fields": [
            {
              "id": "first_name",
              "type": "text",
              "label": "Prénom",
              "required": true,
              "autofocus": true
            },
            {
              "id": "last_name",
              "type": "text",
              "label": "Nom",
              "required": true
            }
          ]
        },
        {
          "id": "school",
          "type": "form",
          "title": "Où étudiez-vous ?",
          "body": "Le quartier décide des professeurs qui peuvent venir.",
          "fields": [
            {
              "id": "institution",
              "type": "combo",
              "label": "Nom de l’école",
              "optionsSource": "institutions",
              "allowCustom": true,
              "required": false,
              "hint": "Laissez vide si vous en cherchez une."
            },
            {
              "id": "region",
              "type": "dropdown",
              "label": "Région",
              "required": true,
              "optionsSource": "regions"
            },
            {
              "id": "city",
              "type": "dropdown",
              "label": "Commune ou préfecture",
              "required": true,
              "optionsSource": "prefectures",
              "optionsFilter": {
                "field": "region"
              }
            },
            {
              "id": "district",
              "type": "text",
              "label": "Quartier",
              "required": true
            }
          ]
        },
        {
          "id": "level_stage",
          "type": "single_choice",
          "title": "Où en êtes-vous dans vos études ?",
          "fieldId": "level_stage",
          "required": true,
          "optionsSource": "stages"
        },
        {
          "id": "level_class",
          "type": "single_choice",
          "title": "En quelle classe ?",
          "fieldId": "level_id",
          "required": true,
          "optionsSource": "levels",
          "optionsFilter": {
            "field": "level_stage"
          },
          "showIf": {
            "field": "level_stage",
            "equals": [
              "PRIMAIRE",
              "COLLEGE",
              "LYCEE",
              "SUPERIEUR"
            ]
          }
        },
        {
          "id": "filiere",
          "type": "single_choice",
          "title": "Quel profil suivez-vous ?",
          "body": "À partir de la 12ème année, le lycée se partage en trois profils. C’est lui qui décide des matières.",
          "fieldId": "filiere_id",
          "required": true,
          "optionsSource": "filieres",
          "showIf": {
            "field": "level_id",
            "equals": [
              "lvl_12",
              "lvl_terminale"
            ]
          }
        },
        {
          "id": "subjects",
          "type": "multi_choice",
          "title": "Dans quelles matières cherchez-vous de l’aide ?",
          "fieldId": "subject_ids",
          "required": true,
          "minSelected": 1,
          "optionsSource": "subjects",
          "searchable": true,
          "searchHint": "Tapez une matière…",
          "optionsFilter": {
            "fields": [
              "level_stage",
              "level_id"
            ]
          }
        }
      ]
    },
    {
      "id": "contact",
      "label": "Contact",
      "steps": [
        {
          "id": "credentials",
          "type": "form",
          "title": "Votre numéro et votre mot de passe",
          "body": "Il protege votre compte. C'est le meme compte sur le site et dans l'application : vous vous connecterez avec ce numero et ce mot de passe des deux cotes.",
          "fields": [
            {
              "id": "phone",
              "type": "phone",
              "label": "Téléphone",
              "required": true
            },
            {
              "id": "password",
              "type": "password",
              "label": "Mot de passe",
              "hint": "Huit caracteres au minimum.",
              "minLength": 8,
              "required": true,
              "autofocus": true
            }
          ]
        },
        {
          "id": "subscription",
          "type": "plan_select",
          "title": "Après vos sept jours d’essai",
          "fieldId": "subscription",
          "plans": [
            {
              "value": "PRO",
              "name": "Découverte",
              "price": 50000,
              "highlight": "Quatre cours enregistrés et deux cours en direct par mois, plus trois questions par jour à l’assistant sur le programme guinéen.",
              "recommended": true
            },
            {
              "value": "MASTER",
              "name": "Illimité",
              "price": 200000,
              "highlight": "Cours et directs sans limite, assistant sans limite, et vos exercices corrigés par le professeur."
            }
          ],
          "declineLabel": "Rester au gratuit",
          "declineValue": "FREE",
          "cta": "Souscrire",
          "body": "Les sept premiers jours sont ouverts : directs, cours, et trois questions par jour à l’assistant. Ensuite, vous choisissez — ou vous restez au gratuit."
        }
      ]
    }
  ]
}
