# Site web (navigateur).
#
# Tout ce qui commence par VITE_ est ECRIT EN CLAIR dans le code du site.
# N'y mettre que des valeurs publiques. Jamais un secret.

# --- Supabase en direct (mode retenu le 25/09) ---------------------------
#
# Les deux se trouvent dans Supabase > Project Settings > API.
#
# La cle « anon » est PUBLIQUE par construction : elle part dans le bundle et
# n'importe qui peut la lire. Ce n'est pas elle qui protege les donnees —
# c'est RLS, table par table. Ne jamais mettre ici la cle « service_role »,
# qui passe outre RLS et donne acces a tout.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- API REST (alternative) ----------------------------------------------
#
# Utilisee seulement si les deux variables Supabase sont vides. Vide aussi :
# le site tourne sur son backend simule et reste entierement parcourable.
VITE_API_BASE_URL=
