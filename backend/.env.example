# ---------------------------------------------------------------------------
# Backend Eduquali — variables serveur uniquement.
#
# Rien ici ne doit se retrouver dans le site (prefixe VITE_) ni dans l'APK :
# l'APK circule de telephone a telephone et se decompile en quelques minutes.
# ---------------------------------------------------------------------------

# Origines autorisees a appeler l'API, separees par des virgules.
# Le site et l'API sont desormais deployes separement : sans cette variable,
# le navigateur bloque les appels du site.
#   ex. https://acalia.vercel.app,https://www.acalia.gn
ALLOWED_ORIGINS=

# Base de donnees, authentification et stockage (Supabase).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Contourne toutes les regles d'acces. Si elle fuit, la regenerer aussitot.
SUPABASE_SERVICE_ROLE_KEY=

# Encaissement (Djomy) — agregateur guineen : Orange Money, MTN MoMo, Kulu,
# cartes.
#
# Les deux identifiants viennent de l'espace marchand. La signature de chaque
# requete est HMAC-SHA256(clientId, clientSecret) : la cle secrete ne circule
# donc jamais, mais elle vaut autant qu'un mot de passe de caisse.
#
# Vides : la demande d'achat s'enregistre « en attente » et personne n'est
# debite. C'est le mode de fonctionnement tant que le compte marchand n'existe
# pas, et l'ecran le dit a l'acheteur.
# sandbox ou production. Obligatoire des que des cles sont posees, et sans
# valeur par defaut : « production » par defaut facturerait de vrais clients
# depuis un poste de developpement, « sandbox » par defaut laisserait une mise
# en ligne encaisser dans le vide. Les deux erreurs sont silencieuses.
#
# En deploiement, il vient de `[vars]` dans wrangler.toml — une valeur par
# cible, visible dans le fichier. Ici, pour le developpement local.
DJOMY_ENVIRONMENT=sandbox

DJOMY_BASE_URL=
DJOMY_CLIENT_ID=
DJOMY_CLIENT_SECRET=
# Signature des webhooks. La documentation dit qu'il s'agit du clientSecret ;
# a renseigner seulement si l'espace developpeur en delivre un distinct.
DJOMY_WEBHOOK_SECRET=
# Code ISO du pays du paiement. GN pour la Guinee.
DJOMY_COUNTRY=GN

# Visioconference (LiveKit Cloud) — cours en direct.
#
# Trois valeurs dans la console LiveKit > Settings > Keys. Le secret signe les
# jetons d'entree : il vaut l'acces a toutes les salles, et il ne quitte jamais
# ce fichier. LiveKit n'a pas de notion de compte — tout le controle d'acces
# passe par les jetons que nous signons.
#
# Vides : la grille s'affiche, on reserve une place, mais aucune salle ne
# s'ouvre. Les ecrans le disent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Hebergement video — CLOUDFLARE STREAM.
#
# Remplace Bunny depuis le 03/10. La raison n'est pas le prix, c'est le reseau :
# R2 et Stream sont chez le meme fournisseur, donc faire passer un enregistrement
# de l'un a l'autre ne traverse pas Internet et ne coute pas d'egress. Et c'est un
# fournisseur de moins — une facture, un jeton, une console et un incident
# possible en moins.
#
# Pourquoi Stream et pas le `.mp4` brut de R2 : l'egress LiveKit produit un
# fichier monolithique. Servi tel quel, le lecteur telecharge au debit du fichier
# et s'arrete a chaque creux de reseau. Stream le decoupe en HLS multi-debits
# (360p a 1080p) : la lecture demarre sur un fragment de deux secondes, et la
# qualite se degrade au lieu de s'interrompre. C'est la difference entre « le
# cours se revoit » et « le cours se revoit chez quelqu'un qui a la fibre ».
#
# CF_ACCOUNT_ID         : tableau de bord Cloudflare, colonne de droite.
# CF_STREAM_API_TOKEN   : My Profile > API Tokens > Create Token, avec la
#                         permission « Stream : Edit » et RIEN d'autre. Un jeton
#                         global donnerait acces au DNS et aux Workers.
# CF_STREAM_CUSTOMER_CODE : le sous-domaine de lecture, « customer-xxxxxxxx ».
#                         Visible dans Stream > n'importe quelle video > le code
#                         d'integration.
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=

# Les URL de lecture sont signees PAR CONSTRUCTION : `requireSignedURLs` est pose
# a l'ingestion de chaque video. Il n'y a pas de variable a renseigner pour cela,
# et c'est voulu — chez Bunny c'etait une option de zone qu'on pouvait oublier
# d'activer, et un cours payant devenait alors telechargeable par tout le monde.

# Depot des enregistrements — CLOUDFLARE R2.
#
# L'egress LiveKit ecrit ici (R2 parle le protocole S3, nativement), puis Stream
# vient ingerer le fichier.
#
# ⚠ LE DEPOT RESTE PRIVE. Le serveur donne a Stream une URL pre-signee valable
# deux heures, le temps de l'ingestion. Rendre le depot public economiserait
# cinquante lignes et rendrait chaque seance de 90 minutes telechargeable par qui
# devine un nom de fichier — et un nom derive d'un identifiant de seance se
# devine.
#
# R2_ENDPOINT           : https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_RECORDINGS_BUCKET  : le nom du depot, cree dans R2 > Create bucket.
# R2_ACCESS_KEY_ID /
# R2_SECRET_ACCESS_KEY  : R2 > Manage API Tokens > Create token, portee
#                         « Object Read & Write » sur ce seul depot.
# R2_REGION             : « auto » chez R2. La variable existe pour un service
#                         compatible S3 qui exigerait une vraie region.
R2_ENDPOINT=
R2_RECORDINGS_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# --- Le webhook LiveKit : a declarer dans la console ---------------------
#
# Il n'y a PAS de variable a remplir ici, et c'est le piege : la presence des
# eleves et le declenchement des rediffusions dependent entierement de cette
# declaration, faite ailleurs.
#
# LiveKit Cloud > Settings > Webhooks > ajouter :
#
#     https://<votre-worker>/api/v1/live/webhooks/livekit
#
# Les evenements utilises : participant_joined, participant_left,
# room_finished, egress_ended.
#
# La signature est verifiee avec LIVEKIT_API_SECRET ci-dessus : rien de plus a
# configurer. Sans cette declaration, les salles fonctionnent, les cours ont
# lieu — et le compteur de temps de cours du parent reste a zero tandis
# qu'aucune rediffusion n'apparait jamais. Le symptome ne designe pas la
# cause.

# Assistant IA (Google Gemini) — offre PAYANTE.
#
# En offre gratuite, les donnees envoyees servent a ameliorer les produits
# Google : inacceptable pour des photos de devoirs d'enfants.
#
# Cette cle ne doit se trouver qu'ici, cote serveur. L'APK circule de
# telephone a telephone et se decompile en quelques minutes : une cle
# embarquee serait lue et facturee sans limite.
#
# Le Worker REFUSE une cle prefixee `VITE_` : Vite recopierait une telle
# variable dans le paquet du site, donc dans le navigateur de chaque visiteur.
#
# Vide : les points de controle d'un cours en direct fonctionnent quand meme —
# le professeur voit ses decomptes, il n'a simplement pas la phrase de synthese.
# `/health` le dit (`aiSummary`).
#
# Modeles employes : `shared/ai/models.json`, verifies par
# `npm run check:gemini`.
#
# Ce qui part chez Google pour un point de controle : une matiere, un numero de
# module et trois nombres. **Aucune donnee personnelle** — ni prenom, ni
# identifiant, ni phrase ecrite par un eleve.
GEMINI_API_KEY=

# Plafond de depense mensuel, en dollars. Atteint, l'assistant se met en
# pause proprement au lieu de continuer a facturer.
AI_MONTHLY_BUDGET_USD=50

# ---------------------------------------------------------------------------
# Deploiement
# ---------------------------------------------------------------------------
#
# Sur Cloudflare Workers, ces valeurs ne vivent PAS dans un fichier : elles se
# posent une par une, chiffrees, et ne se relisent jamais ensuite.
#
#   wrangler secret put SUPABASE_URL
#   wrangler secret put SUPABASE_ANON_KEY
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   wrangler secret put GEMINI_API_KEY
#
# `ALLOWED_ORIGINS` reste dans `wrangler.toml` : une liste de domaines publics
# n'est pas un secret, et la voir versionnee dit qui peut appeler l'API.
#
# Ce fichier-ci ne sert qu'au developpement local (`wrangler dev` lit `.env`).
